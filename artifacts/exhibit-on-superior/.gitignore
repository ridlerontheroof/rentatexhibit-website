# Runtime outputs of the post-publish IndexNow submitter — a submission
# record for the leasing team, not source. Committing them would create
# generated-data drift on task branches.
reports/indexnow/

# Asset-retention store (scripts/retain-assets.mjs): raw copies of recent
# builds' hashed bundles + generation manifest, rewritten by every build.
# Committing it would create generated-data drift on task branches.
asset-retention/

# Autogenerated perf lab outputs — transient runtime state, not source.
perf/SUMMARY.md
perf/latest.json
