{
  "name": "@workspace/exhibit-on-superior",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node scripts/fetch-availability-snapshot.mjs && vite build --config vite.config.ts && vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs && tsx scripts/generate-fact-sheet.ts && node scripts/write-build-id.mjs && node scripts/retain-assets.mjs && node scripts/precompress.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b ../../lib/api-client-react && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:fold": "node scripts/check-units-above-fold.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:a11y:built": "node scripts/check-a11y.mjs --built",
    "check:knowledge": "node scripts/check-knowledge-pages.mjs",
    "check:rented": "node scripts/check-rented-noindex.mjs",
    "check:schema": "node scripts/check-schema-validator.mjs",
    "check:redirects": "node scripts/check-legacy-redirects.mjs",
    "check:floorplans": "node scripts/check-floor-plan-pages.mjs",
    "check:gtm": "node scripts/check-gtm-tracking.mjs",
    "check:hydrated-seo": "node scripts/check-hydrated-seo.mjs",
    "check:starting-price": "node scripts/check-starting-price.mjs",
    "check:assets": "node scripts/check-live-assets.mjs",
    "check:watchdogs": "node scripts/check-watchdog-roster.mjs",
    "check:postpublish": "pnpm run check:knowledge && pnpm run check:rented && pnpm run check:schema && pnpm run check:redirects && pnpm run check:floorplans && pnpm run check:gtm && pnpm run check:hydrated-seo && pnpm run check:starting-price && pnpm run check:assets && pnpm run check:watchdogs",
    "watch:postpublish": "node scripts/watch-postpublish.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "check:fold:built": "node scripts/check-units-above-fold.mjs --built",
    "check:link-names": "node scripts/check-link-names.mjs",
    "check:server:built": "vitest run src/server/production-server.test.ts",
    "check:csp": "node scripts/check-csp-violations.mjs",
    "check:config": "node ../../.agents/skills/property-site-onboarding/tools/validate-config.mjs property-config.json --phase prelaunch",
    "check:watchdog-sync": "node scripts/check-watchdog-sync.mjs",
    "check:prepublish": "pnpm run check:config && pnpm run generate:blog-queue:check && pnpm run check:watchdog-sync && pnpm run build && pnpm run check:fold:built && pnpm run check:link-names && pnpm run check:server:built && pnpm run check:csp",
    "check:perf": "node scripts/check-perf.mjs",
    "generate:unit-map": "node scripts/generate-unit-map.mjs",
    "generate:unit-rewrites": "node scripts/generate-unit-rewrites.mjs",
    "generate:unit-rewrites:check": "node scripts/generate-unit-rewrites.mjs --check",
    "generate:article": "tsx scripts/generate-article.ts && pnpm run generate:blog-queue",
    "generate:blog-queue": "tsx scripts/generate-blog-queue.ts",
    "generate:blog-queue:check": "tsx scripts/generate-blog-queue.ts --check"
  },
