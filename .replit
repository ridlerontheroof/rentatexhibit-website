modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fold"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prepublish-fold"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "unit-rewrites"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "postpublish"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "perf"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/exhibit-on-superior run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "fold"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/exhibit-on-superior run check:fold"

[[workflows.workflow]]
name = "prepublish-fold"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/exhibit-on-superior run check:prepublish"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "unit-rewrites"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/exhibit-on-superior run generate:unit-rewrites:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "postpublish"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/exhibit-on-superior run watch:postpublish"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "perf"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/exhibit-on-superior run check:perf"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
CSP_ENFORCE = "1"
