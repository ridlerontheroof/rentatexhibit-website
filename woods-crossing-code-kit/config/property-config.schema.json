{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highland.example/schemas/property-config-v1.json",
  "title": "Highland property site configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["configVersion", "kitVersion", "environmentManifestPath", "contentManifestPath", "property", "identity", "nap", "brand", "leasing", "appfolio", "seo", "analytics", "email", "secrets"],
  "properties": {
    "configVersion": { "const": "1" },
    "kitVersion": { "const": "kit-v2.0.0" },
    "environmentManifestPath": { "type": "string", "minLength": 1 },
    "contentManifestPath": { "type": "string", "minLength": 1 },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shortName", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalOrigin", "domains"],
      "properties": {
        "canonicalOrigin": { "type": "string", "pattern": "^https://" },
        "domains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "legacyOrigins": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nap": {
      "type": "object",
      "required": ["streetAddress", "locality", "region", "postalCode", "country", "phone", "timezone"],
      "additionalProperties": true
    },
    "brand": { "type": "object", "required": ["designDirection", "tokens"], "additionalProperties": true },
    "leasing": { "type": "object", "required": ["facts"], "additionalProperties": true },
    "appfolio": { "type": "object", "required": ["database", "propertyName", "leadSourceDefault"], "additionalProperties": true },
    "seo": { "type": "object", "required": ["defaultTitleSuffix", "defaultDescription", "ogSiteName"], "additionalProperties": true },
    "analytics": { "type": "object", "required": ["ga4MeasurementId", "utmStorageKey"], "additionalProperties": true },
    "email": { "type": "object", "required": ["leasingInbox", "alertInbox", "senderAddress"], "additionalProperties": true },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
        "optional": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
      }
    }
  }
}