{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "property-content.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "propertySlug", "status", "provenance", "home", "amenities", "neighborhood", "gallery", "floorPlans", "faqs", "knowledge", "blog", "neighborhoodGuides", "legacyRedirects"],
  "properties": {
    "manifestVersion": { "const": "1.0.0" },
    "propertySlug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "enum": ["DRAFT", "APPROVED"] },
    "reviewedBy": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["source", "rightsConfirmed"], "properties": { "source": { "type": "string", "minLength": 1 }, "rightsConfirmed": { "type": "boolean" } } },
    "home": { "$ref": "#/$defs/page" },
    "amenities": { "type": "array", "items": { "$ref": "#/$defs/card" } },
    "neighborhood": { "type": "array", "items": { "$ref": "#/$defs/card" } },
    "gallery": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["src", "alt", "width", "height", "category"], "properties": { "src": { "type": "string", "minLength": 1 }, "alt": { "type": "string", "minLength": 1 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "category": { "type": "string", "minLength": 1 } } } },
    "floorPlans": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "slug", "name", "beds", "baths", "sqft"], "properties": { "id": { "type": "string", "minLength": 1 }, "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "name": { "type": "string", "minLength": 1 }, "beds": { "type": "number", "minimum": 0 }, "baths": { "type": "number", "minimum": 0 }, "sqft": { "type": "integer", "minimum": 1 }, "image": { "type": "string" } } } },
    "faqs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["question", "answer"], "properties": { "question": { "type": "string", "minLength": 1 }, "answer": { "type": "string", "minLength": 1 } } } },
    "knowledge": { "type": "array", "items": { "$ref": "#/$defs/article" } },
    "blog": { "type": "array", "items": { "$ref": "#/$defs/article" } },
    "neighborhoodGuides": { "type": "array", "items": { "$ref": "#/$defs/article" } },
    "legacyRedirects": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string", "pattern": "^/(?!.*(?:\\.\\.|//)).*$" }, "to": { "type": "string", "pattern": "^(?:/(?!.*(?:\\.\\.|//)).*|https://[^\\s]+)$" } } }
  },
  "$defs": {
    "page": { "type": "object", "additionalProperties": false, "required": ["heading", "description"], "properties": { "heading": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } },
    "card": { "type": "object", "additionalProperties": false, "required": ["title", "description"], "properties": { "title": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } },
    "article": { "type": "object", "additionalProperties": false, "required": ["slug", "title", "excerpt", "content"], "properties": { "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "title": { "type": "string", "minLength": 1 }, "excerpt": { "type": "string", "minLength": 1 }, "content": { "type": "string", "minLength": 20 } } }
  },
  "allOf": [{ "if": { "properties": { "status": { "const": "APPROVED" } } }, "then": { "required": ["reviewedBy", "reviewedAt"], "properties": { "provenance": { "properties": { "rightsConfirmed": { "const": true } } } } } }]
}