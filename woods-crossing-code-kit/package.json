{
  "name": "@highland/property-site-kit",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm validate:source && pnpm --filter @highland/property-web run build && pnpm --filter @highland/property-api run build",
    "typecheck": "pnpm -r run typecheck",
    "validate": "node scripts/validate-kit.mjs",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:guards": "node scripts/validate-guards.mjs",
    "validate:neutral": "node scripts/validate-neutrality.mjs",
    "test:neutrality-boundary": "node scripts/test-neutrality-boundary.mjs",
    "validate:source": "node scripts/validate-source.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "release:prepare": "node scripts/release.mjs",
    "check:kit-release": "pnpm test:neutrality-boundary && PROPERTY_CONFIG_PATH=config/example-property-config.json pnpm check:prepublish",
    "smoke": "node scripts/smoke.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "check:acceptance": "node scripts/check-acceptance.mjs && pnpm test:availability-runtime && pnpm test:redirect-map-startup",
    "test:availability-runtime": "node --import tsx scripts/integration-availability-runtime.mjs",
    "test:g5-roster": "node --import tsx scripts/integration-g5-roster.mjs",
    "test:redirect-map-startup": "node scripts/integration-redirect-map-startup.mjs",
    "test:accepted-lead": "node --import tsx scripts/integration-accepted-lead.mjs",
    "test:alerts": "node --import tsx scripts/integration-alerts.mjs",
    "bootstrap:config": "node scripts/bootstrap-config.mjs",
    "check:hydrated-seo": "node scripts/run-baseline-guard.mjs head.per-url",
    "check:server:built": "node scripts/run-baseline-guard.mjs index.real-404",
    "check:schema": "node scripts/run-baseline-guard.mjs jsonld.valid",
    "check:a11y": "node scripts/run-baseline-guard.mjs a11y.axe",
    "check:redirects": "node scripts/run-baseline-guard.mjs redirects.one-hop",
    "check:api": "node scripts/run-baseline-guard.mjs leads.bot-guard",
    "check:rented": "node scripts/run-baseline-guard.mjs appfolio.feed-health",
    "check:postpublish": "node scripts/run-baseline-guard.mjs ops.postpublish-watch",
    "check:content": "node scripts/run-baseline-guard.mjs content.systems-live",
    "check:prepublish": "node scripts/require-property-config.mjs && KIT_GUARD_MODE=offline pnpm validate && pnpm validate:config \"$PROPERTY_CONFIG_PATH\" --phase prelaunch && pnpm validate:release && pnpm validate:source && pnpm check:hydrated-seo && pnpm check:server:built && pnpm check:schema && pnpm check:a11y && pnpm check:redirects && pnpm check:api && pnpm check:rented && pnpm check:postpublish && pnpm check:content && pnpm test:g5-roster && pnpm typecheck && pnpm smoke && pnpm build && pnpm check:acceptance && pnpm test:accepted-lead && pnpm test:alerts",
    "prepublish:online": "KIT_GUARD_MODE=online node scripts/run-all-online.mjs"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "express": "5.2.1",
    "jsdom": "26.1.0",
    "pg-mem": "3.0.14",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}